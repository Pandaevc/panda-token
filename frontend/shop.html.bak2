<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>熊猫智能电子烟 - PandaToken</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--primary:#FF6B35;--accent:#FFD700;--success:#00E676;--dark:#0D0D0D;--darker:#050505;--surface:#1A1A1A;--text:#FFF;--text-muted:#888;--g:linear-gradient(135deg,#FF6B35,#FF9800);--g2:linear-gradient(135deg,#FFD700,#FF9800);--b:1px solid rgba(255,255,255,0.08)}
body{background:var(--darker);color:var(--text);font-family:system-ui,sans-serif;min-height:100vh}
.bg{position:fixed;inset:0;z-index:-1;background:var(--darker);background-image:radial-gradient(circle at 30% 20%,rgba(255,107,53,0.15),transparent 50%),radial-gradient(circle at 70% 80%,rgba(255,215,0,0.1),transparent 50%)}
header{position:fixed;top:0;inset-x:0;z-index:100;padding:16px 0;background:rgba(5,5,5,0.9);backdrop-filter:blur(20px);border-bottom:var(--b)}
.c{max-width:1200px;margin:0 auto;padding:0 24px;display:flex;justify-content:space-between;align-items:center}
.logo{display:flex;align-items:center;gap:12px;font-size:22px;font-weight:700}
.logo-icon{width:42px;height:42px;background:var(--g);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:24px;box-shadow:0 0 30px rgba(255,107,53,0.4)}
.logo-text{background:var(--g2);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
nav{display:flex;gap:36px}
nav a{color:#B0B0B0;text-decoration:none;font-weight:500;font-size:14px}
nav a:hover{color:#fff}
.actions{display:flex;align-items:center;gap:16px}
.login-btn{background:0;color:var(--primary);border:2px solid var(--primary);padding:8px 18px;border-radius:20px;font-weight:600;cursor:pointer;font-size:13px}
.login-btn:hover{);color:#fffbackground:var(--primary}
.user-info{display:none;align-items:center;gap:10px}
.user-info .name{font-weight:600;font-size:14px}
.cart-btn{background:var(--primary);color:#fff;border:none;padding:10px 22px;border-radius:25px;font-weight:600;position:relative;cursor:pointer}
.cart-btn .c{position:absolute;top:-8px;right:-8px;background:#FF1744;width:20px;height:20px;border-radius:50%;font-size:11px;display:flex;align-items:center;justify-content:center}
.hero{background:linear-gradient(180deg,#1A1A1A 0%,var(--darker) 100%);padding:160px 24px 80px;text-align:center}
.hero h1{font-size:48px;font-weight:800;margin-bottom:16px}
.hero p{color:#B0B0B0;font-size:18px;max-width:500px;margin:0 auto}
.prods{padding:80px 24px;max-width:1100px;margin:0 auto}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.vis{position:relative}
.ecig{width:100%;max-width:260px;height:360px;margin:0 auto;background:linear-gradient(180deg,#1a1a2e,#0f0f1a);border-radius:28px;position:relative;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,0.5)}
.screen{position:absolute;top:28px;left:18px;right:18px;height:150px;background:#000;border-radius:12px;overflow:hidden}
.scr-con{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:40px;gap:6px}
.scr-con.spin{animation:spin .1s infinite}
@keyframes spin{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.scr-res{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:14px;font-weight:bold;color:var(--accent);display:none}
.scr-res.show{display:block}
.led{position:absolute;bottom:22px;left:18px;right:18px;height:22px;background:linear-gradient(90deg,var(--primary),var(--accent));border-radius:8px;animation:led 2s infinite}
@keyframes led{0%,100%{opacity:1}50%{opacity:0.6}}
.mouth{position:absolute;bottom:-22px;left:50%;transform:translateX(-50%);width:46px;height:46px;background:linear-gradient(180deg,#333,#1a1a1a);border-radius:0 0 14px 14px}
.info h2{font-size:34px;margin-bottom:14px}
.info .desc{color:#B0B0B0;font-size:16px;line-height:1.7;margin-bottom:22px}
.feats{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:28px}
.feat{background:rgba(255,87,34,0.1);color:var(--primary);padding:8px 16px;border-radius:20px;font-size:13px;border:1px solid rgba(255,87,34,0.2)}
.buy-card{background:var(--surface);border:var(--b);border-radius:18px;padding:28px}
.price{display:flex;align-items:center;gap:12px;margin-bottom:8px}
.price .c{font-size:40px;font-weight:700;color:var(--primary)}
.price .o{font-size:16px;color:#666;text-decoration:line-through}
.token{background:var(--g);color:#fff;padding:12px 20px;border-radius:24px;display:inline-block;margin:14px 0;font-size:15px;font-weight:600}
.buy-btn{width:100%;padding:18px;background:var(--g);border:none;border-radius:14px;color:#fff;font-size:17px;font-weight:700;cursor:pointer}
.pay{padding:80px 24px;background:rgba(0,0,0,0.3)}
.pay h2{text-align:center;font-size:36px;margin-bottom:12px}
.pay > p{text-align:center;color:#B0B0B0;margin-bottom:40px}
.mets{display:flex;justify-content:center;gap:14px;margin-bottom:40px}
.met{padding:16px 30px;background:var(--surface);border:2px solid rgba(255,255,255,0.08);border-radius:14px;font-size:15px;font-weight:600;cursor:pointer}
.met:hover,.met.active{border-color:var(--primary);background:rgba(255,107,53,0.1)}
.chk{background:var(--surface);border:var(--b);border-radius:18px;padding:32px;max-width:560px;margin:0 auto}
.chk h3{margin-bottom:22px;font-size:18px}
.sec{margin-bottom:26px;padding-bottom:26px;border-bottom:var(--b)}
.sec:last-child{border:none;margin-bottom:0;padding-bottom:0}
.sec h4{font-size:15px;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.g{margin-bottom:14px}
.g label{display:block;margin-bottom:8px;font-weight:500;font-size:14px}
.g input,.g select{width:100%;padding:14px;background:var(--dark);border:1px solid rgba(255,255,255,0.12);border-radius:10px;color:#fff;font-size:15px}
.summ{background:var(--dark);padding:18px;border-radius:12px;margin:18px 0}
.summ .r{display:flex;justify-content:space-between;padding:8px 0;font-size:14px}
.summ .r.t{font-size:18px;font-weight:700;color:var(--primary);border-top:1px solid rgba(255,255,255,0.1);margin-top:8px;padding-top:12px}
.chk-btn{width:100%;padding:18px;background:var(--g);border:none;border-radius:14px;color:#fff;font-size:16px;font-weight:700;cursor:pointer}
.res{margin-top:18px;padding:18px;border-radius:12px;display:none}
.res.show{display:block}
.res.suc{background:rgba(0,230,118,0.1);border:1px solid var(--success)}
.res h4{color:var(--success);margin-bottom:10px}
.res p{margin:6px 0;font-size:14px}
.modal{position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:200;display:none;align-items:center;justify-content:center}
.modal.show{display:flex}
.mod{background:var(--surface);border:var(--b);border-radius:18px;padding:32px;max-width:400px;width:90%;text-align:center}
.mod h3{color:#fff;margin-bottom:22px;font-size:18px}
.mod input{width:100%;padding:14px;background:var(--dark);border:1px solid rgba(255,255,255,0.12);border-radius:10px;color:#fff;font-size:15px;margin-bottom:12px}
.mod button{padding:14px 32px;background:var(--primary);color:#fff;border:none;border-radius:25px;font-weight:600;cursor:pointer;width:100%}
footer{padding:40px 24px;border-top:var(--b);text-align:center}
footer p{color:var(--text-muted);font-size:13px}
footer a{color:var(--primary);text-decoration:none}
@media(max-width:900px){.grid{grid-template-columns:1fr;gap:40px}}
@media(max-width:600px){nav{display:none}.hero h1{font-size:32px}}
</style>
</head>
<body>
<div class="bg"></div>
<header><div class="c"><div class="logo"><div class="logo-icon">🐼</div><div class="logo-text">熊猫闪充</div></div><nav><a href="#prods">产品</a><a href="#pay">支付</a><a href="index.html">DApp</a></nav><div class="actions"><button class="login-btn" id="lBtn" onclick="showL()">登录</button><div class="user-info" id="uInfo"><span class="name" id="uName"></span><button class="login-btn" onclick="logOut()">退出</button></div><button class="cart-btn" onclick="scrollChk()">🛒 <span class="c" id="cCount">0</span></button></div></div></header>
<section class="hero"><h1>🎰 熊猫智能电子烟</h1><p>全球首款带老虎机的智能电子烟！吸烟同时参与抽奖，代币惊喜不断</p></section>
<section class="prods" id="prods"><div class="grid"><div class="vis"><div class="ecig"><div class="screen"><div class="scr-con" id="scrCon">🍒 🍒 🍒</div><div class="scr-res" id="scrRes"></div></div><div class="led"></div><div class="mouth"></div></div></div><div class="info"><h2>🎰 熊猫智能电子烟 Pro</h2><p class="desc">全球首款带智能屏幕的电子烟！每次吸烟时老虎机自动转动，有机会获得PANDA代币密钥！</p><div class="feats"><span class="feat">🎰 智能老虎机</span><span class="feat">🔊 中奖提示</span><span class="feat">🔑 3000 PANDA密钥</span><span class="feat">🔋 超长续航</span></div><div class="buy-card"><div class="price"><span class="c">$70</span><span class="o">$99</span></div><div class="token">🎰 包含 3,000 PANDA 代币密钥</div><button class="buy-btn" onclick="buyNow()">🛒 立即购买</button></div></div></div></section>
<section class="pay" id="pay"><h2>💳 选择支付方式</h2><p>安全快捷，支持多种支付方式</p><div class="mets"><div class="met active" onclick="selM('usdt')">🔷 USDT</div><div class="met" onclick="selM('visa')">💳 Visa</div><div class="met" onclick="selM('mc')">💳 Mastercard</div></div><div class="chk" id="chkForm"><h3>📝 订单信息</h3><div class="sec"><h4>👤 用户信息</h4><div class="g"><label>登录邮箱</label><input type="email" id="ordEmail" placeholder="用于账户绑定"></div></div><div class="sec"><h4>📦 收货信息</h4><div class="g"><label>收货人 *</label><input type="text" id="shipName" placeholder="姓名">></div><div<label>联系电话 *</label><input type="tel" id="shipPhone" placeholder="电话"></div><div class="g"><label>国家/地区 *</label><select id="shipCountry"><option value="">选择国家</option><option value="CN">中国</option><option value="US">美国</option><option value="UK">英国</option><option value="DE">德国</option><option value="JP">日本</option><option value="SV">萨尔瓦多</option></select></div><div class="g"><label>详细地址 *</label><input type="text" id="shipAddr" placeholder="街道、城市、邮编"></div></div><div class="sec"><h4>🔷 支付信息</h4><div class="g"><label>USDT地址 (TRC20)</label><select id="usdtAddr"><option value="TDPBRADTHB4GP4VHWVDYNAEJXKQM3D3E3E">地址1 (推荐)</option><option value="TMbrADTHB4GP4VHWVDYNAEJXKQM4D4E4F">地址2</option><option value="TSbrADTHB4GP4VHWVDYNAEJXKQM5D5E5F">地址3</option></select></div><div class="g"><label>交易哈希 (TX Hash) *</label><input type="text" id="txHash" placeholder="USDT转账后的交易哈希"></div><div class="g"><label>钱包地址 (领代币) *</label><input type="text" id="walletAddr" placeholder="TRC20钱包地址"></div></div><div class="summ"><div class="r"><span>熊猫智能电子烟 Pro</span><span>$70</span></div><div class="r"><span>代币密钥</span><span>3,000 PANDA</span></div><div class="r t"><span>总计</span><span>$70 USD</span></div></div><button class="chk-btn" onclick="subOrd()">✅ 确认订单</button><div class="res" id="resBox"><h4>🎉 订单提交成功！</h4><p><strong>订单号:</strong> <span id="ordId"></span></p><p><strong>物流单号:</strong> <span id="trackId"></span></p></div></div></section>
<footer><p>© 2026 熊猫闪充 - 红熵科技 | <a href="https://www.pandaevc.com">www.pandaevc.com</a></p></footer>
<div class="modal" id="logModal"><div class="mod"><h3>🔐 用户登录/注册</h3><input type="email" id="logEmail" placeholder="邮箱"><input type="password" id="logPass" placeholder="密码"><input type="text" id="logName" placeholder="昵称(可选)"><button onclick="doLog()">登录 / 注册</button></div></div>
<script>
var log=false,usrE="",usrN="",pMeth="usdt";
function showL(){document.getElementById("logModal").classList.add("show");}
function doLog(){var e=document.getElementById("logEmail").value.trim(),n=document.getElementById("logName").value.trim()||e.split("@")[0];if(!e){alert("请输入邮箱");return;}log=true;usrE=e;usrN=n;document.getElementById("lBtn").style.display="none";document.getElementById("uInfo").style.display="flex";document.getElementById("uName").innerHTML=usrN;document.getElementById("ordEmail").value=usrE;document.getElementById("logModal").classList.remove("show");alert("登录成功！欢迎 "+usrN);}
function logOut(){log=false;usrE="";usrN="";document.getElementById("lBtn").style.display="block";document.getElementById("uInfo").style.display="none";}
function buyNow(){if(!log){alert("请先登录");showL();return;}document.getElementById("pay").scrollIntoView({behavior:"smooth"});}
function scrollChk(){document.getElementById("chkForm").scrollIntoView({behavior:"smooth"});}
function selM(m){document.querySelectorAll(".met").forEach(function(x){x.classList.remove("active")});event.target.classList.add("active");pMeth=m;}
function subOrd(){var n=document.getElementById("shipName").value.trim(),p=document.getElementById("shipPhone").value.trim(),c=document.getElementById("shipCountry").value,a=document.getElementById("shipAddr").value.trim(),tx=document.getElementById("txHash").value.trim();if(!log){alert("请先登录");showL();return;}if(!n||!p||!c||!a){alert("请填写完整信息");return;}if(pMeth==="usdt"&&!tx){alert("请填写USDT交易哈希");return;}var oid="ORD"+Date.now(),tid="PKG"+Math.random().toString(36).substr(2,10).toUpperCase();document.getElementById("ordId").innerHTML=oid;document.getElementById("trackId").innerHTML=tid;document.getElementById("resBox").classList.add("show");}
function spinScr(){var syms=["🍒","🍋","🍇","💎","🎰","🐼"];var con=document.getElementById("scrCon");con.classList.add("spin");var cnt=0;var int=setInterval(function(){con.innerHTML=syms[Math.floor(Math.random()*syms.length)]+" "+syms[Math.floor(Math.random()*syms.length)]+" "+syms[Math.floor(Math.random()*syms.length)];cnt++;if(cnt>15){clearInterval(int);con.classList.remove("spin");var fin=syms[Math.floor(Math.random()*syms.length)];con.innerHTML=fin+" "+fin+" "+fin;var res=document.getElementById("scrRes");if(Math.random()>0.5){res.innerHTML="🎉 中奖！";res.style.color="var(--accent)";}else{res.innerHTML="🔄 再接再厉!";res.style.color="#fff";}res.classList.add("show");}},100);}
setInterval(spinScr,3000);
</script>
</body>
</html>
